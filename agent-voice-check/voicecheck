#!/usr/bin/env python3
"""Catch the turns of phrase the agent-voice standard forbids.

Two layers, so the expensive one stays small. A deterministic pass finds
sentences carrying a known phrase and reports which phrase fired. One AI
Gateway decision call then asks a small decision model, per candidate, which
of the five voice problems the sentence has; a sentence is reported when the
model puts less than the threshold probability on "none". The gate exists
because a regex cannot tell "the effect carries a stale index" from "the chip
carries a label", and the model is cheap enough (about 40 microseconds of a
dollar per sentence) to ask every time.

The five problems, from the `agent-voice` skill:

  subject  the subject is something other than the work
  writer   the sentence is about the writer's confidence, candor or standing
  claim    it corrects an objection nobody raised, or is a fragment as heading
  reader   it asserts importance or tours the document
  shape    padding whose rhythm carries it

Exit codes: 0 clean, 1 findings, 2 the check could not run.
"""

from __future__ import annotations

import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

EVALUATE_URL = "https://ai-gateway.vercel.sh/v1/evaluate"
DEFAULT_MODEL = "openai/gpt-6-luna-decisions"
DEFAULT_THRESHOLD = 0.5
DEFAULT_TOP = 10
MAX_CANDIDATES = 24

# One row per phrase worth naming. `family` is the problem the gate is asked
# to confirm; the regex only has to be generous, because the gate decides.
PATTERNS: list[tuple[str, str, str]] = [
    ("rather than", "claim", r"\brather than\b"),
    ("instead of", "claim", r"\binstead of\b"),
    ("not X but Y", "claim", r"\bnot\s+\w+[,;]?\s+but\b"),
    ("X, not Y", "claim", r",\s+not\s+(?:a|an|the|its|their|what|how)\b"),
    ("bold fragment", "claim", r"(?m)^\s*\*\*[^*\n]{3,80}[.:]\*\*\s*$"),
    ("gets no X at all", "subject", r"\bgets?\s+(?:no|nothing)\b[^.!?\n]{0,60}\bat all\b"),
    ("nothing but", "subject", r"\bnothing\s+but\b|\bnothing\s+(?:tying|marking|holding|linking)\b"),
    ("minimizer", "subject", r"\b(?:just|simply|merely|little more than|nothing else)\b"),
    ("abstract verb", "subject", r"\b(?:carries?|carrying|names|becomes|surfaces|exposes|leverages|utilises|utilizes)\s+(?:a|an|the|one|its)\b"),
    ("ascribed intent", "subject", r"\b(?:deliberately|on purpose|by design|intentionally)\b"),
    ("evidence framing", "writer", r"\b(?:evidence|findings?|observations?|observed|inferred|proves?|proven|certainty|corroborat\w+)\b"),
    ("candor grading", "writer", r"\b(?:honest\w*|candid\w*|frankly|transparent\w*)\b"),
    ("performed doubt", "writer", r"\b(?:somewhere in|hard to say|not 100% sure|cannot yet|can'?t yet|not sure exactly)\b"),
    ("vibe word", "writer", r"\b(?:reads as|feels like|actually|genuinely)\b"),
    ("em-dash aside", "writer", r"—[^—\n]{40,}—"),
    ("absolute", "reader", r"\bthe only\s+\w+\s+that\b|\bthe most important\b|\bthe whole point\b|\bthe one (?:real|thing|row|question|place|part)\b"),
    ("document tour", "reader", r"\b(?:this page|this section|this document|the section below|listed below|at the top|as follows|the rest of this)\b"),
    ("importance opener", "shape", r"\b(?:it'?s worth noting|importantly|crucially|needless to say)\b"),
]

DEVICES = (
    "1. it contrasts its claim against a reading nobody offered, saying what a thing is not in order to "
    "preempt a complaint ('the shape is a rail rather than a bullet list', 'not a drawing, a change'); "
    "2. it minimises what it describes ('gets no X at all, only Y', 'nothing but', 'just', 'simply'); "
    "3. it gives a layout or component an intention ('deliberately', 'on purpose'); "
    "4. it reports the writer's own certainty or candor ('evidence', 'finding', 'observed', "
    "'honest caveats', 'I cannot yet name it'); "
    "5. it asserts unearned importance or uniqueness ('the most important thing', 'the only row that', "
    "'the whole point'); "
    "6. it talks about the document instead of the subject ('this page shows', 'listed below'); "
    "7. it uses an abstract verb where a plain one exists ('carries a title', 'names the field', "
    "'becomes a panel')."
)

STRICT = (
    "Flag the sentence when it uses one of the devices listed above. Say which one, and leave the "
    "question of whether that use was justified to the reader of the report."
)

# How often a flagged sentence carrying this phrase turned out to be a real
# violation, measured by hand on 200 audited sentences from BB pi sessions.
# The contrast patterns are the weak ones; every abstract verb and candor word
# was real. Ranking multiplies the gate score by this so the shortlist puts the
# trustworthy phrases first.
PRIORS = {
    "candor grading": 1.00,
    "gets no X at all": 1.00,
    "vibe word": 0.78,
    "abstract verb": 0.71,
    "evidence framing": 0.50,
    "em-dash aside": 0.50,
    "ascribed intent": 0.50,
    "rather than": 0.35,
    "minimizer": 0.25,
    "instead of": 0.22,
}

FIXES = {
    "subject": "name what the thing does, then what happened to it",
    "writer": "say what happened and let the reader weigh it",
    "claim": "state the claim; give a real contrast its own sentence",
    "reader": "say what changed for the reader, then stop",
    "shape": "cut to the fact; let the lengths vary with the difficulty",
}

CRITERIA = {
    "subject": "the subject is something other than the work: it minimises ('gets no X at all, only Y'), describes what is absent, gives a layout an intention ('deliberately'), or uses an abstract verb for plain data ('carries', 'names', 'becomes')",
    "writer": "the sentence is about the writer's own confidence, candor or standing ('evidence', 'finding', 'observed', 'honest caveats', 'I cannot yet name it', 'reads as')",
    "claim": "the sentence corrects an objection nobody raised by contrasting its claim with an alternative ('X rather than Y'), or dresses a fragment as a heading",
    "reader": "the sentence asserts importance or absolutes ('the only', 'the most important thing') or tours the document ('this page shows') instead of saying what changed for the reader",
    "shape": "the sentence is padding whose rhythm carries it: a turned-down closer, an importance opener, a clause that explains a fact nobody questioned",
    "none": "none of these; the sentence states a fact about the work plainly",
}

FENCE = re.compile(r"^\s*(```|~~~)")
ABBREVIATIONS = ("e.g.", "i.e.", "vs.", "etc.", "cf.", "no.", "fig.", "approx.")
INLINE = [
    (re.compile(r"`([^`]*)`"), r"\1"),
    (re.compile(r"\*\*([^*]*)\*\*"), r"\1"),
    (re.compile(r"(?<!\*)\*([^*]+)\*(?!\*)"), r"\1"),
    (re.compile(r"!?\[([^\]]*)\]\([^)]*\)"), r"\1"),
    (re.compile(r"(^|\s)[-*+]\s+"), r"\1"),
    (re.compile(r"^\s*#{1,6}\s*"), ""),
    (re.compile(r"^\s*>\s*"), ""),
    (re.compile(r"^\s*\d+[.)]\s*"), ""),
]


def plain(markdown: str) -> str:
    """The sentence a reader sees, without the markdown that carried it."""
    out = markdown
    for pattern, replacement in INLINE:
        out = pattern.sub(replacement, out)
    return re.sub(r"\s+", " ", out).strip()


def blocks(text: str):
    """Split markdown into paragraphs, list items and headings, tracked by line."""
    current: list[str] = []
    start = 0
    line_no = 0
    in_fence = False
    for raw in text.splitlines():
        line_no += 1
        if FENCE.match(raw):
            if current:
                yield start, "\n".join(current)
                current = []
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        stripped = raw.strip()
        starts_block = bool(re.match(r"^(#{1,6}\s|[-*+]\s|\d+[.)]\s)", stripped))
        if not stripped or starts_block:
            if current:
                yield start, "\n".join(current)
                current = []
            if not stripped:
                continue
        if not current:
            start = line_no
        current.append(raw)
    if current:
        yield start, "\n".join(current)


def sentences(paragraph: str):
    """Split one block into sentences, joining the lines it wraps across."""
    flat = plain(paragraph)
    guarded = flat
    for abbreviation in ABBREVIATIONS:
        guarded = guarded.replace(abbreviation, abbreviation.replace(".", "\u2024"))
    parts = re.split(r"(?<=[.!?])\s+(?=[\"'\u201c(\[]?[A-Z0-9$])", guarded)
    return [plain(p.replace("\u2024", ".")) for p in parts if plain(p).strip()]


def units(text: str):
    """Yield (line, sentence) for prose only, one unit per sentence."""
    for start, block in blocks(text):
        heading = block.lstrip().startswith("#")
        pieces = [plain(block)] if heading else sentences(block)
        for piece in pieces:
            if piece:
                yield start, piece


def candidates(text: str, exhaustive: bool = False):
    """Candidate sentences, and how many sentences were examined at all.

    Nothing is excluded. A quoted label, a component name and a sentence the
    document marks as a bad example all still reach the gate, because the reader
    of the report decides what to keep and a checker that hides cases takes that
    decision away from them.
    """
    found = []
    examined = 0
    for index, (line, sentence) in enumerate(units(text)):
        examined += 1
        hits = [name for name, _, pattern in PATTERNS if re.search(pattern, sentence)]
        if not hits and not exhaustive:
            continue
        if exhaustive and not hits:
            # No phrase to report, so the sentence goes to the gate on its own
            # merits. This is how a construction with no keyword — a passive or
            # actorless sentence — gets judged at all.
            hits = ["no phrase"]
        found.append({"offset": index, "line": line, "sentence": sentence, "matched": hits})
    return found, examined


def ask(items, model: str, key: str, timeout: float):
    """One request: a strict problem/clean gate and a problem family per sentence."""
    questions = {}
    for index, item in enumerate(items):
        questions[f"g{index}"] = {
            "type": "choice",
            "instructions": (
                "Here is one sentence written by an AI agent: "
                f"{item['sentence']!r}. Does it use one of the listed devices? {STRICT}"
            ),
            "criteria": {
                "problem": "the sentence uses at least one of the seven listed devices",
                "clean": "the sentence states its facts plainly, or uses the words in their ordinary sense",
            },
        }
        questions[f"f{index}"] = {
            "type": "choice",
            "instructions": (
                "Here is one sentence written by an AI agent: "
                f"{item['sentence']!r}. Which of the voice problems does it have? "
                "Answer 'none' when it states its fact plainly."
            ),
            "criteria": CRITERIA,
        }
    body = json.dumps(
        {
            "model": model,
            "state": "You are auditing one agent-written sentence against a voice standard. Devices to flag:\n" + DEVICES,
            "questions": questions,
        }
    ).encode()
    request = urllib.request.Request(
        EVALUATE_URL,
        data=body,
        headers={"content-type": "application/json", "Authorization": f"Bearer {key}"},
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        payload = json.loads(response.read())
    answers = payload.get("answers", {})
    gateway = (payload.get("providerMetadata") or {}).get("gateway") or {}
    cost = float(gateway.get("cost") or 0) + float(gateway.get("surchargeCost") or 0)
    return answers, cost


def report(findings, *, as_json, elapsed_ms, cost, checked, model, total):
    if as_json:
        print(
            json.dumps(
                {
                    "findings": [
                        {
                            "line": f["line"],
                            "sentence": f["sentence"],
                            "problem": f["problem"],
                            "confidence": round(f["confidence"], 2),
                            "matched": f["matched"],
                            "fix": FIXES[f["problem"]],
                        }
                        for f in findings
                    ],
                    "checked": checked,
                    "model": model,
                    "costUsd": round(cost, 7),
                    "elapsedMs": elapsed_ms,
                },
                indent=2,
            )
        )
        return
    if not findings:
        print(f"voicecheck: clean ({checked} sentences, {elapsed_ms} ms, ${cost:.6f})")
        return
    print(f"voicecheck: {total} finding(s) in {checked} sentences")
    if total > len(findings):
        print(f"  showing the top {len(findings)}")
    print("  This is a first pass: expect roughly a third of these to be false alarms.\n")
    for f in findings:
        print(f'  line {f["line"]}  {f["problem"]} ({f["confidence"]:.2f})')
        print(f'    {f["sentence"]}')
        print(f'    matched: {", ".join(f["matched"])}')
        print(f'    fix: {FIXES[f["problem"]]}\n')
    print(f"  {elapsed_ms} ms, ${cost:.6f}, model {model}")


def selftest(model: str, key: str) -> int:
    """Run the labeled fixtures and report what a first pass cares about.

    Recall first: every known violation should come back. False alarms are
    acceptable when they rank below the violations, because the reader works
    down a ranked list and stops when it stops paying.
    """
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "evals", "fixtures.jsonl")
    cases = [json.loads(line) for line in open(path, encoding="utf-8") if line.strip()]
    items = [
        {"offset": i, "line": i + 1, "sentence": c["sentence"], "matched": [c["why"]]}
        for i, c in enumerate(cases)
    ]
    started = time.monotonic()
    answers, cost = ask(items, model, key, timeout=60)
    elapsed_ms = int((time.monotonic() - started) * 1000)
    scored = []
    for index, case in enumerate(cases):
        gate = answers.get(f"g{index}") or {}
        score = (gate.get("probabilities") or {}).get("problem", 0.0)
        scored.append((score, case["flag"], case["sentence"]))
    violations = [s for s in scored if s[1]]
    clean = [s for s in scored if not s[1]]
    caught = sum(1 for score, _, _ in violations if score >= DEFAULT_THRESHOLD)
    flagged_clean = sum(1 for score, _, _ in clean if score >= DEFAULT_THRESHOLD)
    for score, flag, sentence in sorted(scored, reverse=True):
        mark = "flag" if score >= DEFAULT_THRESHOLD else "    "
        print(f"{mark} want={flag} p={score:.2f}  {sentence[:70]}")
    worst_violation = min(score for score, _, _ in violations)
    best_clean = max(score for score, _, _ in clean)
    ranked_apart = worst_violation > best_clean
    print(f"\ncaught {caught}/{len(violations)} violations, {flagged_clean}/{len(clean)} clean "
          f"sentences flagged at {DEFAULT_THRESHOLD}, {elapsed_ms} ms, ${cost:.6f}")
    print(f"every violation ranks above every clean sentence: {ranked_apart} "
          f"(lowest violation {worst_violation:.2f} vs highest clean {best_clean:.2f})")
    return 0 if caught == len(violations) else 1


def main(argv: list[str]) -> int:
    args = [a for a in argv[1:]]
    as_json = "--json" in args
    no_model = "--no-model" in args
    quiet = "--quiet" in args
    show_all = "--all" in args
    exhaustive = "--exhaustive" in args
    threshold = DEFAULT_THRESHOLD
    top = DEFAULT_TOP
    model = DEFAULT_MODEL
    limit = MAX_CANDIDATES
    paths = []
    skip_next = False
    for index, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if arg in ("--threshold", "--model", "--max-candidates", "--top"):
            value = args[index + 1] if index + 1 < len(args) else ""
            skip_next = True
            if arg == "--threshold":
                threshold = float(value)
            elif arg == "--model":
                model = value
            elif arg == "--top":
                top = int(value)
            else:
                limit = int(value)
        elif arg.startswith("-") and arg != "-":
            continue
        else:
            paths.append(arg)

    if "--selftest" in args:
        key = os.environ.get("AI_GATEWAY_API_KEY", "").strip()
        if not key:
            print("voicecheck: --selftest needs AI_GATEWAY_API_KEY", file=sys.stderr)
            return 2
        return selftest(DEFAULT_MODEL, key)

    if paths and paths[0] == "-":
        text = sys.stdin.read()
        source = "<stdin>"
    elif paths:
        try:
            text = "\n".join(open(p, encoding="utf-8").read() for p in paths)
        except OSError as error:
            print(f"voicecheck: cannot read {error.filename}", file=sys.stderr)
            return 2
        source = paths[0]
    else:
        if sys.stdin.isatty():
            print(__doc__.strip().splitlines()[0], file=sys.stderr)
            print("usage: voicecheck [--json] [--no-model] [FILE ...]  (or pipe text in)", file=sys.stderr)
            return 2
        text = sys.stdin.read()
        source = "<stdin>"

    found, examined = candidates(text, exhaustive)
    started = time.monotonic()
    checked, cost, notes = examined, 0.0, []
    key = os.environ.get("AI_GATEWAY_API_KEY", "").strip()

    if found and not no_model and key:
        answers: dict = {}
        cost = 0.0
        pending = found if exhaustive else found[:limit]
        for start in range(0, len(pending), MAX_CANDIDATES):
            chunk = pending[start : start + MAX_CANDIDATES]
            try:
                chunk_answers, chunk_cost = ask(chunk, model, key, timeout=60)
            except (urllib.error.URLError, TimeoutError, ValueError) as error:
                notes.append(f"model pass failed ({error}); phrase pass only")
                break
            for number in range(len(chunk)):
                answers[f"g{start + number}"] = chunk_answers.get(f"g{number}", {})
                answers[f"f{start + number}"] = chunk_answers.get(f"f{number}", {})
            cost += chunk_cost
        findings = []
        # Every sentence that was scored is eligible to be reported. Slicing to
        # `limit` here made an exhaustive run pay for the whole document and
        # report the first 24 sentences of it.
        for index, item in enumerate(pending):
            gate = answers.get(f"g{index}") or {}
            probabilities = gate.get("probabilities") or {}
            if probabilities.get("problem", 0.0) < threshold:
                continue
            family = (answers.get(f"f{index}") or {}).get("choice") or "none"
            if family == "none":
                family = _family_of(item["matched"][0])
            prior = max((PRIORS.get(name, 0.5) for name in item["matched"]), default=0.5)
            findings.append(
                {
                    **item,
                    "problem": family,
                    "confidence": probabilities.get("problem", 0.0),
                    "rank": probabilities.get("problem", 0.0) * prior,
                }
            )
        findings.sort(key=lambda f: -f["rank"])
        for item in ([] if exhaustive else found[limit:]):
            findings.append({**item, "problem": item["matched"] and _family_of(item["matched"][0]) or "shape", "confidence": 0.0})
    else:
        if not no_model and not key:
            notes.append("AI_GATEWAY_API_KEY is unset; phrase pass only")
        findings = [
            {**item, "problem": _family_of(item["matched"][0]), "confidence": 0.0} for item in found
        ]

    elapsed_ms = int((time.monotonic() - started) * 1000)
    for note in notes:
        print(f"voicecheck: {note}", file=sys.stderr)

    total = len(findings)
    hidden = 0
    if findings and not show_all and len(findings) > top:
        hidden = len(findings) - top
        findings = findings[:top]

    if quiet:
        return 1 if findings else 0
    report(findings, as_json=as_json, elapsed_ms=elapsed_ms, cost=cost, checked=checked, model=model, total=total)
    if not as_json:
        if hidden:
            print(f"  {hidden} more above the threshold; pass --all to list them")
        if findings:
            print(f"  in {source}")
    return 1 if findings else 0


def _family_of(name: str) -> str:
    for pattern_name, family, _ in PATTERNS:
        if pattern_name == name:
            return family
    return "shape"


if __name__ == "__main__":
    sys.exit(main(sys.argv))
